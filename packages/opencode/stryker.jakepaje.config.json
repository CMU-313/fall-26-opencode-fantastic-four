{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test test/command/debugging.property.test.ts"
  },
  "coverageAnalysis": "off",
  "mutate": [
    "src/command/index.ts:38-50"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "tempDirName": ".stryker-tmp/jakepaje",
  "concurrency": 2,
  "timeoutMS": 30000
}
